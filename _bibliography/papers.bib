title="Bi-objective Optimization of Electric Vehicle Charging Scheduling with Heterogeneous Chargers Under Time-Varying Electricity Prices",
booktitle="Computational Science and Its Applications -- ICCSA 2026",
year="2027",
publisher="Springer Nature Switzerland",
address="Cham",
doi= {10.1007/978-3-032-30494-0_36},
pages="568--586",
abstract="This paper addresses the optimization of charging schedules in EV charging stations with heterogeneous chargers under time-varying electricity prices. The objective is to decide which demands to accept and how to schedule them to maximize the number of demands served while minimizing electricity costs. We formulate the problem as a bi-objective model and compare two approaches: an exact {\$}{\$}{\backslash}varepsilon {\$}{\$}$\epsilon$-constraint method and a hybrid NSGA-II enhanced with repair mechanisms and refinement procedures. Computational results on 70 benchmark instances with up to 400 EVs and four price scenarios show that the hybrid NSGA-II produces well-distributed Pareto fronts and achieves competitive performance on small instances, while significantly outperforming the exact method on large instances, with improvements of up to {\$}{\$}+59.89{\backslash}{\%}{\$}{\$}+59.89{\%}in normalized hypervolume and an average gain of {\$}{\$}+40.8{\backslash}{\%}{\$}{\$}+40.8{\%}for instances with 300--400 EVs. In addition, it reduces computation time by up to {\$}{\$}77{\backslash}{\%}{\$}{\$}77{\%}, with an average reduction of {\$}{\$}65{\backslash}{\%}{\$}{\$}65{\%}for instances ranging from 50 to 400 EVs.",
isbn="978-3-032-30494-0",
preview={izi.png}
}